{
  "packages": [
    "../packages/pi-lockdown",
    "npm:@plannotator/pi-extension",
    "npm:@dotc/pi-platform-ai-provider",
    "npm:@dotc/pi-core"
  ],
  "modelThinkingLevels": {
    "platform-ai/gemini-3.8-flash": "medium",
    "platform-ai/azure.claude-haiku-5-5": "medium",
    "platform-ai/bedrock.claude-haiku-5-5": "medium",
    "platform-ai/vertex_ai.claude-haiku-5-5": "medium",
    "platform-ai/azure.claude-sonnet-5-5": "medium",
    "platform-ai/bedrock.claude-sonnet-5-5": "medium",
    "platform-ai/vertex_ai.claude-sonnet-5-5": "medium",
    "platform-ai/azure.claude-opus-5-5": "medium",
    "platform-ai/bedrock.claude-opus-5-5": "medium",
    "platform-ai/vertex_ai.claude-opus-5-5": "medium",
    "platform-ai/bedrock.gpt-6-luna": "medium",
    "platform-ai/bedrock.gpt-6-sol": "medium",
    "platform-ai/bedrock.gpt-6.1-sol": "medium"
  },
  "runNpmScript": {
    "packageManager": "pnpm",
    "validScripts": [
      "build",
      "lint",
      "lint:fix",
      "check-types",
      "format",
      "format:fix",
      "test",
      "--filter @dotc/pi-core build",
      "--filter @dotc/pi-platform-ai-provider",
      "--filter @dotc/pi-lockdown test"
    ]
  },
  "lockdown": {
    "customTools": {
      "current_date": "allow",
      "run_npm_script": "allow",
      "commit_changes": "allow",
      "git_changes": "allow",
      "git_worktree_add": "allow",
      "shadcn_search": "warn",
      "shadcn_docs": "warn",
      "chakra_v2_docs": "allow",
      "chakra_v2_search": "allow",
      "fetch_url": "warn",
      "nest_generate": "warn",
      "subagent": "allow"
    },
    "defaultTools": ["read", "edit", "write", "grep", "find", "ls"],
    "fileSystemAccess": {
      "denyRead": ["**/.env*"],
      "allowRead": [
        ".",
        "./**/.env.development",
        "~/.pi/agent/install/releases/*/node_modules/@earendil-works/pi-*/**"
      ],
      "allowWrite": ["e2e/"],
      "denyWrite": ["**/.env*", "**/.git/**", "**/node_modules/**", ":external"]
    }
  },
  "lockdownSubagent": {
    "customTools": {
      "current_date": "allow",
      "run_npm_script": "allow",
      "commit_changes": "block",
      "git_changes": "allow",
      "shadcn_search": "allow",
      "shadcn_docs": "allow",
      "fetch_url": "allow",
      "chakra_v2_docs": "allow",
      "chakra_v2_search": "allow",
      "nest_generate": "block",
      "subagent": "block"
    },
    "defaultTools": ["read", "grep", "find", "ls"],
    "fileSystemAccess": {
      "denyRead": ["**/.env*"],
      "allowRead": [
        ".",
        "./**/.env.development",
        "~/.pi/agent/install/releases/*/node_modules/@earendil-works/pi-*/**"
      ],
      "allowWrite": ["e2e/"],
      "denyWrite": ["**/.env*", "**/.git/**", "**/node_modules/**", ":external"]
    }
  }
}
