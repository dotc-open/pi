{
  "name": "dotc-pi",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "format": "prettier --check \"**/*.{ts,js,mjs,json,yaml,yml,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,mjs,json,yaml,yml,md}\"",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "pnpm lint:fix",
      "pnpm format:fix"
    ],
    "*.{json,yaml,yml,md}": [
      "pnpm format:fix"
    ]
  }
