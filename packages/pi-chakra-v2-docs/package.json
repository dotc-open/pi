{
  "name": "@dotc/pi-chakra-v2-docs",
  "version": "0.1.0",
  "description": "Chakra UI v2 documentation extension for Pi",
  "author": "DOTC",
  "license": "MIT",
  "keywords": [
    "pi-chakra-v2-docs",
    "pi-package"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "skills",
    "snapshot",
    "docs"
  ],
  "pi": {
    "extensions": [
      "dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
