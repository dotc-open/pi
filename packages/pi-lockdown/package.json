{
  "name": "@dotc/pi-lockdown",
  "version": "0.1.0",
  "description": "A Pi extension to add security constraints to agent tool usage.",
  "author": "DOTC",
  "license": "MIT",
  "keywords": [
    "pi-lockdown",
    "pi-package"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
